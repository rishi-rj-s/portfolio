{
  "name": "rishiraj-portfolio",
  "version": "2.0.0",
  "author": {
    "name": "rishi-rj-s",
    "email": "rishirajsajeev@gmail.com"
  },
  "description": "The curios portfolio of Rishiraj Sajeev 😁",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve --watch --open",
    "build:prod": "ng build --configuration production",
    "build": "node set-env.js && pnpm run build:prod",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:rishiraj-portfolio": "node dist/rishiraj-portfolio/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.15",
    "@angular/compiler": "^21.2.15",
    "@angular/core": "^21.2.15",
    "@angular/forms": "^21.2.15",
    "@angular/platform-browser": "^21.2.15",
    "@angular/platform-server": "^21.2.15",
    "@angular/router": "^21.2.15",
    "@angular/ssr": "^21.2.13",
    "express": "^5.1.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.18",
    "ng-hcaptcha": "^2.7.0",
    "rxjs": "~7.8.0",
    "three": "^0.182.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.15",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "@types/three": "^0.182.0",
    "baseline-browser-mapping": "^2.9.12",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "log-update": "^8.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@10.32.1"
}
